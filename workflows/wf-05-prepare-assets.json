      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.job_id, c.site_key, c.status, c.manifest_file_id, c.drive_folder_id, c.target_languages, s.publishing_policy FROM content_jobs c LEFT JOIN site_configs s USING (site_key) WHERE c.job_id = $1 LIMIT 1;",
