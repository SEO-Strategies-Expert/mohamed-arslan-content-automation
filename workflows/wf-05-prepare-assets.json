      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.job_id, c.site_key, c.status, c.manifest_file_id, c.drive_folder_id, c.target_languages FROM content_jobs c WHERE c.job_id = $1 LIMIT 1;",
        "options": {
