    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE content_jobs\nSET status = 'CANCELLED', last_error = $2, updated_at = NOW()\nWHERE job_id = $1 AND status NOT IN ('PUBLISHED','COMPLETED')\nRETURNING job_id, status;",
        "options": {
          "queryReplacement": "={{ [$json.jobId, ($json.reason || \"Cancelled via content_job tool\")] }}"
        }
      },
