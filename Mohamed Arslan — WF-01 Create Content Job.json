        "jsCode": "const c = $json;\nconst m = c.manifest || {};\nconst operation = m.operation || \"create_article\";\nconst idempotencyKey = c.jobId + \":\" + operation + \":create\";\nconst approvalRequired = (m.publication && typeof m.publication.approvalRequired === \"boolean\") ? m.publication.approvalRequired : true;\nreturn {\n  jobId: c.jobId,\n  siteKey: c.siteKey,\n  environment: c.environment,\n  driveFolderId: c.driveFolderId,\n  manifestFileId: c.manifestFileId,\n  operation,\n  status: \"CREATED\",\n  sourceLanguage: m.sourceLanguage || null,\n  targetLanguages: Array.isArray(m.targetLanguages) ? m.targetLanguages : [],\n  requestedBy: m.requestedBy || null,\n  approvalRequired,\n  idempotencyKey,\n};"
