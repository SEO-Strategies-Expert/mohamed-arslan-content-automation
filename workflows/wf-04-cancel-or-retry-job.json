        "query": "INSERT INTO job_events (job_id, event_type, workflow_name, execution_id, payload)\nVALUES ($1, 'RETRY_INITIATED', 'Mohamed Arslan — WF-04 Cancel or Retry Content Job', $2, $3::jsonb);",
        "options": {
