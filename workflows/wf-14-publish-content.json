    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO job_events (job_id, event_type, workflow_name, execution_id, payload)\nVALUES ($1, 'PUBLISHED_PENDING_VERIFICATION', 'Mohamed Arslan — WF-14 Publish Content', $2, $3::jsonb);",
        "options": {
          "queryReplacement": "={{ [$json.job_id, $execution.id, JSON.stringify({ contentId: $(\"09 Evaluate Publish API Response\").item.json.contentId, publishedUrls: $(\"09 Evaluate Publish API Response\").item.json.publishedUrls })] }}"
        }
      },
      "id": "12820194-9128-4091-a829-102938102975",
      "name": "12 Log Publish Event",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        2464,
        64
      ],
