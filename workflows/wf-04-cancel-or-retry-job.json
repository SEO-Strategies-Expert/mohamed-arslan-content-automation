    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json || {};\nconst jobId = (j.jobId || \"\").trim();\nconst action = (j.action || \"\").trim().toLowerCase();\nconst reason = (j.reason || \"Action requested via WF-04\").trim();\nlet errorCode = null;\nlet errorMessage = null;\nif (!jobId) {\n  errorCode = \"INVALID_INPUT\";\n  errorMessage = \"jobId is required.\";\n} else if (![\"cancel\", \"retry\"].includes(action)) {\n  errorCode = \"INVALID_ACTION\";\n  errorMessage = \"action must be either 'cancel' or 'retry'.\";\n}\nreturn { jobId, action, reason, ok: errorCode === null, errorCode, errorMessage };"
      },
      "id": "02810294-8172-491a-b812-701928301924",
      "name": "02 Validate Input",
