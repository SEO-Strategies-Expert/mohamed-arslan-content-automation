    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const base = $(\"03B Verify Lock Acquired\").item.json;\nconst item = $input.item;\nlet manifest = {};\ntry {\n  if (item.binary && item.binary.data && item.binary.data.data) {\n    manifest = JSON.parse(Buffer.from(item.binary.data.data, \"base64\").toString(\"utf-8\"));\n  }\n} catch (e) {\n  manifest = {};\n}\n\nconst assetTasks = [];\nconst jobTitle = manifest.title || \"\";\nconst jobExcerpt = manifest.excerpt || \"\";\n\nif (manifest.assets) {\n  if (manifest.assets.featuredImage) {\n    const fi = manifest.assets.featuredImage;\n    assetTasks.push({\n      jobId: base.jobId,\n      assetKey: \"featured-main\",\n      assetType: \"featured_image\",\n      mode: fi.mode || \"generate_background_and_render_text\",\n      headline: fi.headline || jobTitle,\n      subheadline: fi.subheadline || jobExcerpt,\n      driveFileId: fi.driveFileId || null\n    });\n  }\n  if (Array.isArray(manifest.assets.infographics)) {\n    for (const ig of manifest.assets.infographics) {\n      if (ig && ig.key) {\n        assetTasks.push({\n          jobId: base.jobId,\n          assetKey: ig.key,\n          assetType: \"infographic\",\n          template: ig.template || \"cost-breakdown\",\n          title: ig.title || jobTitle,\n          data: ig.data || {}\n        });\n      }\n    }\n  }\n  if (manifest.assets.beforeAfter) {\n    const ba = manifest.assets.beforeAfter;\n    assetTasks.push({\n      jobId: base.jobId,\n      assetKey: ba.key || \"before-after-1\",\n      assetType: \"before_after\",\n      category: ba.category || \"general\"\n    });\n  }\n}\n\nif (assetTasks.length === 0) {\n  assetTasks.push({\n    jobId: base.jobId,\n    assetKey: \"featured-main\",\n    assetType: \"featured_image\",\n    mode: \"generate_background_and_render_text\",\n    headline: jobTitle || \"Article Asset\",\n    subheadline: jobExcerpt || \"\"\n  });\n}\n\nreturn assetTasks.map(task => ({ json: task }));"
      },
