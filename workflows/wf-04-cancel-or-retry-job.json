    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const input = $(\"02 Validate Input\").item.json;\nconst row = $(\"10 Execute Cancel Job\").item.json;\nif (!row || !row.job_id) {\n  return {\n    success: false,\n    jobId: input.jobId,\n    status: \"FAILED\",\n    message: \"Job could not be cancelled — non-cancellable status or job not found.\",\n    data: null,\n    warnings: [],\n    errors: [{ code: \"CANCEL_FAILED\", language: null, path: null, message: \"Job is already PUBLISHED, COMPLETED, or CANCELLED.\" }],\n    nextAllowedActions: [\"status\"]\n  };\n}\nreturn {\n  success: true,\n  jobId: row.job_id,\n  status: \"CANCELLED\",\n  message: \"Content job cancelled successfully.\",\n  data: { reason: input.reason },\n  warnings: [],\n  errors: [],\n  nextAllowedActions: []\n};"
      },
      "id": "12820194-9128-4091-a829-102938102951",
      "name": "12 Build Cancel Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        192
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE content_jobs\nSET status = CASE WHEN status = 'VALIDATION_FAILED' THEN 'CREATED' ELSE 'CONTENT_READY' END,\n    retry_count = retry_count + 1,\n    last_error = NULL,\n    updated_at = NOW()\nWHERE job_id = $1 AND status IN ('FAILED','VALIDATION_FAILED','ASSETS_PROCESSING')\nRETURNING job_id, status, retry_count;",
        "options": {
          "queryReplacement": "={{ $json.jobId }}"
        }
      },
      "id": "20820194-9128-4091-a829-102938102952",
