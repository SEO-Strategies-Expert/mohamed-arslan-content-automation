    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const jobCtx = $(\"03 Check Job State\").item.json.job;\nreturn {\n  jobId: jobCtx.job_id,\n  siteKey: jobCtx.site_key,\n  driveFolderId: jobCtx.drive_folder_id,\n  manifestFileId: jobCtx.manifest_file_id,\n  processedAssets: [\n    { assetKey: \"featured-main\", type: \"featured_image\", status: \"READY\" },\n    { assetKey: \"cost-breakdown-1\", type: \"infographic\", status: \"READY\" }\n  ]\n};"
      },
