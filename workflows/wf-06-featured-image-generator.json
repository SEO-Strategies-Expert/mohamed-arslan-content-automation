    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json || {};\nconst mode = j.mode || \"generate_background_and_render_text\";\nconst validModes = [\"existing_drive_image\", \"generate_background_and_render_text\", \"render_from_template\"];\nif (!validModes.includes(mode)) {\n  return {\n    ok: false,\n    errorCode: \"INVALID_MODE\",\n    errorMessage: \"Mode must be one of: \" + validModes.join(\", \")\n  };\n}\nreturn {\n  jobId: j.jobId || \"MOHAMED-ARSLAN-TEST\",\n  mode,\n  headline: j.headline || \"عنوان مقال تجريبي\",\n  subheadline: j.subheadline || \"نص فرعي توضيحي\",\n  driveFileId: j.driveFileId || null,\n  ok: true\n};"
      },
      "id": "02810294-8172-491a-b812-701928301926",
      "name": "02 Validate Parameters",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        192
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const p = $(\"02 Validate Parameters\").item.json;\n// Programmatic text rendering mock\nconst renderedTextOverlay = {\n  headlineText: p.headline,\n  subheadlineText: p.subheadline,\n  fontFamily: \"Inter, Cairo, sans-serif\",\n  logoPosition: \"top-right\",\n  safeAreaMarginPx: 40\n};\nreturn {\n  assetKey: \"featured-main\",\n  assetType: \"featured_image\",\n  generatorMode: p.mode,\n  renderedOverlay: renderedTextOverlay,\n  width: 1200,\n  height: 630,\n  mimeType: \"image/png\",\n  previewUrl: \"https://development.example.com/assets/featured-main.png\"\n};"
      },
      "id": "03820194-9128-4019-a829-109284019286",
      "name": "03 Render Programmatic Featured Image",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        192
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const img = $(\"03 Render Programmatic Featured Image\").item.json;\nconst p = $(\"02 Validate Parameters\").item.json;\nreturn {\n  success: true,\n  jobId: p.jobId,\n  status: \"ASSETS_READY\",\n  message: \"Featured image generated programmatically with clear text and safe areas.\",\n  data: img,\n  warnings: [],\n  errors: [],\n  nextAllowedActions: [\"optimize_images\"]\n};"
      },
