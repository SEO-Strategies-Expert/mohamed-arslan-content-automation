    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lockCtx = $(\"05B Verify Lock Acquired\").item.json;\nconst resp = $json || {};\nconst statusCode = typeof resp.statusCode === \"number\" ? resp.statusCode : 0;\nconst body = resp.body !== undefined ? resp.body : resp;\nconst isSuccess = (statusCode >= 200 && statusCode < 300) && body && body.publishedUrls && typeof body.publishedUrls === \"object\" && Object.keys(body.publishedUrls).length > 0;\n\nif (!isSuccess) {\n  return {\n    ok: false,\n    jobId: lockCtx.jobId,\n    lockKey: lockCtx.lockKey,\n    contentId: lockCtx.contentId,\n    errorCode: \"PUBLISH_API_FAILED\",\n    errorMessage: (body && body.message) ? body.message : \"Custom Site API publish endpoint returned HTTP \" + statusCode + \" or invalid payload.\"\n  };\n}\n\nreturn {\n  ok: true,\n  jobId: lockCtx.jobId,\n  lockKey: lockCtx.lockKey,\n  contentId: body.contentId || lockCtx.contentId,\n  publishedUrls: body.publishedUrls\n};"
      },
