      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE content_jobs SET status = 'FAILED', last_error = $2, updated_at = NOW() WHERE job_id = $1;",
        "options": {
          "queryReplacement": "={{ [$json.jobId, $json.errorMessage] }}"
        }
      },
      "id": "14820194-9128-4091-a829-102938102976",
