    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE content_jobs SET status = 'VERIFYING', published_urls = $3::jsonb, lock_key = NULL, lock_expires_at = NULL, updated_at = NOW() WHERE job_id = $1 AND lock_key = $2 RETURNING job_id, status;",
        "options": {
          "queryReplacement": "={{ [$json.jobId, $json.lockKey, JSON.stringify($json.publishedUrls)] }}"
        }
      },
      "id": "11820194-9128-4091-a829-102938102974",
      "name": "11 Update Status VERIFYING and Release Scoped Lock",
      "type": "n8n-nodes-base.postgres",
