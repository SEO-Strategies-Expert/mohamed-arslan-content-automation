        "jsCode": "const input = $(\"04 Validate Job ID\").item.json;\nconst row = $json && $json.site_key ? $json : null;\nlet errorCode = null;\nlet errorMessage = null;\nif (!row) {\n  errorCode = \"SITE_NOT_FOUND\";\n  errorMessage = \"No site_configs row found for site_key \" + input.siteKey + \".\";\n} else if (row.active !== true) {\n  errorCode = \"SITE_INACTIVE\";\n  errorMessage = \"Site \" + input.siteKey + \" is not active.\";\n} else if (String(row.environment) !== String(input.environment)) {\n  errorCode = \"ENVIRONMENT_MISMATCH\";\n  errorMessage = \"Requested environment \" + input.environment + \" does not match site environment \" + row.environment + \".\";\n}\nreturn {\n  jobId: input.jobId,\n  siteKey: input.siteKey,\n  environment: input.environment,\n  driveFolderId: input.driveFolderId,\n  siteConfig: row,\n  ok: errorCode === null,\n  errorCode,\n  errorMessage,\n};"
