      "id": "e140284a-7182-44df-a8b2-5f60d6211234",
      "name": "01 Input Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        192
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.job_id, c.site_key, c.status, c.content_id, c.target_languages, c.approval_required, c.approved_by, s.api_base_url FROM content_jobs c LEFT JOIN site_configs s USING (site_key) WHERE c.job_id = $1 LIMIT 1;",
        "options": {
          "queryReplacement": "={{ $json.jobId }}"
        }
      },
      "id": "02810294-8172-491a-b812-701928301935",
      "name": "02 Load Job Details and Site Config",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        192
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const input = $(\"01 Input Trigger\").item.json;\nconst row = ($json && $json.job_id) ? $json : null;\nlet errorCode = null;\nlet errorMessage = null;\nif (!row) {\n  errorCode = \"JOB_NOT_FOUND\";\n  errorMessage = \"No content_jobs row found for jobId \" + input.jobId;\n} else if (!row.api_base_url) {\n  errorCode = \"SITE_CONFIG_MISSING\";\n  errorMessage = \"site_configs api_base_url is missing or not configured for site_key \" + row.site_key;\n} else if (!row.content_id) {\n  errorCode = \"MISSING_CONTENT_ID\";\n  errorMessage = \"content_id is missing on job. Cannot publish without a valid content_id.\";\n} else if (row.approval_required && row.status !== \"APPROVED\") {\n  errorCode = \"APPROVAL_REQUIRED\";\n  errorMessage = \"Publishing requires human approval. Current status: \" + row.status;\n}\nreturn { jobId: input.jobId, job: row, ok: errorCode === null, errorCode, errorMessage };"
      },
      "id": "03820194-9128-4019-a829-109284019295",
      "name": "03 Verify Eligibility",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        192
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "ok",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "04829104-9128-4902-8172-910293810305",
      "name": "04 Eligibility Check Passed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        672,
        192
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE content_jobs SET lock_key = $2, lock_expires_at = NOW() + INTERVAL '5 minutes', status = 'PUBLISHING', updated_at = NOW() WHERE job_id = $1 AND status = 'APPROVED' AND (lock_expires_at IS NULL OR lock_expires_at < NOW()) RETURNING job_id, lock_key, content_id;",
        "options": {
          "queryReplacement": "={{ [$json.jobId, (\"LOCK-\" + Date.now())] }}"
        }
      },
      "id": "05820194-9128-4091-a829-102938102971",
      "name": "05 Acquire Lock and Set Status PUBLISHING",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        896,
        128
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const locked = ($json && $json.job_id) ? true : false;\nconst base = $(\"03 Verify Eligibility\").item.json;\nif (!locked) {\n  return { ok: false, jobId: base.jobId, errorCode: \"PUBLISH_LOCKED\", errorMessage: \"Could not acquire publish lock or status is no longer APPROVED.\" };\n}\nreturn { ok: true, jobId: base.jobId, job: base.job };"
      },
      "id": "05B0194-9128-4091-a829-102938102971",
      "name": "05B Verify Lock Acquired",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        128
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $json.job.api_base_url }}/content/{{ $json.job.content_id }}",
        "options": {
          "timeout": 5000
        }
      },
      "id": "06810294-8172-491a-b812-701928301937",
      "name": "06 Fetch Existing Page Content Snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1120,
        128
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "CUSTOM_SITE_API_CREDENTIAL_ID",
          "name": "Custom Site API Auth"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const jobCtx = $(\"03 Verify Eligibility\").item.json.job;\nconst resp = $json || {};\nconst isSnapshotValid = !resp.error && resp.contentId && !resp.status;\nif (!isSnapshotValid) {\n  return {\n    ok: false,\n    jobId: jobCtx.job_id,\n    errorCode: \"SNAPSHOT_FETCH_FAILED\",\n    errorMessage: \"Failed to fetch existing content snapshot from Custom Site API GET endpoint. Cannot proceed with pre-publish revision snapshot.\"\n  };\n}\nreturn {\n  ok: true,\n  jobId: jobCtx.job_id,\n  contentId: jobCtx.content_id,\n  snapshot: resp\n};"
      },
      "id": "06B0194-9128-4091-a829-102938102972",
      "name": "06B Validate Snapshot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1230,
        128
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "ok",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "06C0194-9128-4091-a829-102938102972",
      "name": "06C Snapshot OK Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1340,
        128
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO content_revisions (job_id, content_id, revision_id, snapshot)\nVALUES ($1, $2, $3, $4::jsonb)\nRETURNING id, revision_id;",
        "options": {
          "queryReplacement": "={{ [$json.jobId, $json.contentId, (\"REV-\" + Date.now()), JSON.stringify($json.snapshot)] }}"
        }
      },
      "id": "07820194-9128-4091-a829-102938102972",
      "name": "07 Save Revision Record",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1460,
        64
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $(\"03 Verify Eligibility\").item.json.job.api_base_url }}/content/{{ $json.contentId }}/publish",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $(\"03 Verify Eligibility\").item.json.job.job_id }}-publish-v1"
            }
          ]
        },
        "options": {
          "timeout": 5000
        }
      },
      "id": "08810294-8172-491a-b812-701928301938",
      "name": "08 Call Custom Site Publish API Adapter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1680,
        64
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "CUSTOM_SITE_API_CREDENTIAL_ID",
          "name": "Custom Site API Auth"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const jobCtx = $(\"03 Verify Eligibility\").item.json.job;\nconst resp = $json || {};\nconst isSuccess = !resp.error && resp.publishedUrls && typeof resp.publishedUrls === \"object\" && Object.keys(resp.publishedUrls).length > 0;\n\nif (!isSuccess) {\n  return {\n    ok: false,\n    jobId: jobCtx.job_id,\n    errorCode: \"PUBLISH_API_FAILED\",\n    errorMessage: (resp && resp.message) ? resp.message : \"Custom Site API publish endpoint failed or returned invalid response.\"\n  };\n}\n\nreturn {\n  ok: true,\n  jobId: jobCtx.job_id,\n  contentId: resp.contentId || jobCtx.content_id,\n  publishedUrls: resp.publishedUrls\n};"
      },
      "id": "09820194-9128-4019-a829-109284019296",
