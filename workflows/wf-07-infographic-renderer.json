    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json || {};\nconst template = j.template || \"cost-breakdown\";\nconst validTemplates = [\n  \"stats-grid\", \"process-steps\", \"comparison\", \"timeline\",\n  \"checklist\", \"cost-breakdown\", \"before-after-explanation\", \"faq-summary\"\n];\nif (!validTemplates.includes(template)) {\n  return {\n    ok: false,\n    errorCode: \"INVALID_TEMPLATE\",\n    errorMessage: \"template must be one of: \" + validTemplates.join(\", \")\n  };\n}\nreturn {\n  jobId: j.jobId || \"MOHAMED-ARSLAN-TEST\",\n  template,\n  title: j.title || \"رسم توضيحي تفصيلي\",\n  data: j.data || {},\n  ok: true\n};"
      },
      "id": "02810294-8172-491a-b812-701928301927",
      "name": "02 Validate Infographic Template",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        192
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const p = $(\"02 Validate Infographic Template\").item.json;\nreturn {\n  assetKey: \"infographic-\" + p.template + \"-1\",\n  assetType: \"infographic\",\n  template: p.template,\n  renderedTitle: p.title,\n  width: 1080,\n  height: 1080,\n  mimeType: \"image/png\",\n  previewUrl: \"https://development.example.com/assets/infographic-\" + p.template + \".png\"\n};"
      },
      "id": "03820194-9128-4019-a829-109284019287",
      "name": "03 Render SVG Infographic Template",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        192
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ig = $(\"03 Render SVG Infographic Template\").item.json;\nconst p = $(\"02 Validate Infographic Template\").item.json;\nreturn {\n  success: true,\n  jobId: p.jobId,\n  status: \"ASSETS_READY\",\n  message: \"Infographic rendered successfully using template: \" + p.template,\n  data: ig,\n  warnings: [],\n  errors: [],\n  nextAllowedActions: [\"optimize_images\"]\n};"
      },
