    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const res = $(\"09 Evaluate Publish API Response\").item.json || $json || {};\nconst code = res.errorCode || \"PUBLISH_ERROR\";\nconst message = res.errorMessage || \"An error occurred while publishing content.\";\nconst jobId = res.jobId || null;\nreturn {\n  success: false,\n  jobId,\n  status: \"FAILED\",\n  message,\n  data: null,\n  warnings: [],\n  errors: [{ code, language: null, path: null, message }],\n  nextAllowedActions: [\"retry\", \"cancel\"]\n};"
      },
