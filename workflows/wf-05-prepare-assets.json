    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const base = $(\"03B Verify Lock Acquired\").item.json;\nconst item = $input.item;\nlet manifest = null;\nlet manifestError = null;\n\ntry {\n  if (item.binary && item.binary.data && item.binary.data.data) {\n    const rawStr = Buffer.from(item.binary.data.data, \"base64\").toString(\"utf-8\");\n    manifest = JSON.parse(rawStr);\n  } else {\n    manifestError = \"Manifest file binary data is missing.\";\n  }\n} catch (e) {\n  manifestError = \"Failed to parse job manifest JSON: \" + e.message;\n}\n\nif (!manifest || manifestError) {\n  return {\n    json: {\n      ok: false,\n      jobId: base.jobId,\n      lockKey: base.lockKey,\n      errorCode: \"INVALID_MANIFEST\",\n      errorMessage: manifestError || \"Job manifest file is missing or invalid.\"\n    }\n  };\n}\n\nconst assetTasks = [];\nconst jobTitle = manifest.title || \"\";\nconst jobExcerpt = manifest.excerpt || \"\";\nconst policy = (base.job && base.job.publishing_policy) || {};\n\nif (manifest.assets) {\n  if (manifest.assets.featuredImage) {\n    const fi = manifest.assets.featuredImage;\n    assetTasks.push({\n      jobId: base.jobId,\n      lockKey: base.lockKey,\n      assetKey: \"featured-main\",\n      assetType: \"featured_image\",\n      language: \"ar\",\n      mode: fi.mode || \"generate_background_and_render_text\",\n      headline: fi.headline || jobTitle,\n      subheadline: fi.subheadline || jobExcerpt,\n      driveFileId: fi.driveFileId || null,\n      ok: true\n    });\n  }\n  if (Array.isArray(manifest.assets.infographics)) {\n    for (const ig of manifest.assets.infographics) {\n      if (ig && ig.key) {\n        assetTasks.push({\n          jobId: base.jobId,\n          lockKey: base.lockKey,\n          assetKey: ig.key,\n          assetType: \"infographic\",\n          language: \"ar\",\n          template: ig.template || \"cost-breakdown\",\n          title: ig.title || jobTitle,\n          data: ig.data || {},\n          ok: true\n        });\n      }\n    }\n  }\n  if (manifest.assets.beforeAfter) {\n    const ba = manifest.assets.beforeAfter;\n    assetTasks.push({\n      jobId: base.jobId,\n      lockKey: base.lockKey,\n      assetKey: ba.key || \"before-after-1\",\n      assetType: \"before_after\",\n      language: \"ar\",\n      category: ba.category || \"general\",\n      ok: true\n    });\n  }\n}\n\n// If manifest specifies no assets and policy requires featured image\nif (assetTasks.length === 0 && policy.require_featured_image && jobTitle) {\n  assetTasks.push({\n    jobId: base.jobId,\n    lockKey: base.lockKey,\n    assetKey: \"featured-main\",\n    assetType: \"featured_image\",\n    language: \"ar\",\n    mode: \"generate_background_and_render_text\",\n    headline: jobTitle,\n    subheadline: jobExcerpt,\n    ok: true\n  });\n}\n\nif (assetTasks.length === 0) {\n  return [{\n    json: {\n      jobId: base.jobId,\n      lockKey: base.lockKey,\n      assetKey: null,\n      assetType: \"none\",\n      emptyAssets: true,\n      ok: true\n    }\n  }];\n}\n\nreturn assetTasks.map(task => ({ json: task }));"
      },
