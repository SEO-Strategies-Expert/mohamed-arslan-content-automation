    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item;\nconst j = item.json || {};\nconst jobId = j.jobId || null;\nconst assetKey = j.assetKey || \"featured-main\";\n\nconst binaryObj = item.binary && item.binary.data ? item.binary.data : null;\nif (!binaryObj || !binaryObj.data) {\n  return {\n    json: {\n      ok: false,\n      jobId,\n      errorCode: \"MISSING_BINARY_IMAGE\",\n      errorMessage: \"No binary image data supplied for image optimization.\"\n    }\n  };\n}\n\nconst crypto = require(\"crypto\");\nconst binaryBuffer = Buffer.from(binaryObj.data, \"base64\");\nconst fileSizeBytes = binaryBuffer.length;\nconst checksum = crypto.createHash(\"sha256\").update(binaryBuffer).digest(\"hex\");\nconst mimeType = binaryObj.mimeType || \"image/webp\";\n\nreturn {\n  json: {\n    ok: true,\n    jobId,\n    assetKey,\n    fileSizeBytes,\n    checksum,\n    mimeType\n  },\n  binary: item.binary\n};"
      },
      "id": "02810294-8172-491a-b812-701928301929",
