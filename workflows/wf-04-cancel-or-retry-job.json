      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO job_events (job_id, event_type, workflow_name, execution_id, payload)\nVALUES ($1, 'CANCELLED', 'Mohamed Arslan — WF-04 Cancel or Retry Content Job', $2, $3::jsonb);",
        "options": {
          "queryReplacement": "={{ [$(\"10 Execute Cancel Job\").item.json.job_id, $execution.id, JSON.stringify({ reason: $(\"02 Validate Input\").item.json.reason })] }}"
        }
      },
      "id": "11820194-9128-4091-a829-102938102950",
      "name": "11 Log Cancel Event",
