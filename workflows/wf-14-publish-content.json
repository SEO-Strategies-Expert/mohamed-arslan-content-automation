    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lockCtx = $(\"05B Verify Lock Acquired\").item.json;\nconst resp = $json || {};\nconst statusCode = typeof resp.statusCode === \"number\" ? resp.statusCode : 0;\nconst body = resp.body !== undefined ? resp.body : resp;\nconst isSnapshotValid = (statusCode >= 200 && statusCode < 300) && body && typeof body === \"object\" && !body.error;\n\nif (!isSnapshotValid) {\n  return {\n    ok: false,\n    jobId: lockCtx.jobId,\n    lockKey: lockCtx.lockKey,\n    contentId: lockCtx.contentId,\n    errorCode: \"SNAPSHOT_FETCH_FAILED\",\n    errorMessage: \"Failed to fetch existing content snapshot from Custom Site API (HTTP \" + statusCode + \"). Cannot proceed with pre-publish revision snapshot.\"\n  };\n}\nreturn {\n  ok: true,\n  jobId: lockCtx.jobId,\n  lockKey: lockCtx.lockKey,\n  contentId: lockCtx.contentId,\n  snapshot: body\n};"
      },
