        "jsCode": "const jobId = $(\"02 Validate Tool Input\").item.json.jobId;\nconst row = ($json && $json.job_id) ? $json : null;\nif (!row) {\n  return {\n    success: false,\n    jobId,\n    status: \"FAILED\",\n    message: \"Job could not be cancelled — it may not exist or is already PUBLISHED/COMPLETED.\",\n    data: null,\n    warnings: [],\n    errors: [{ code: \"CANCEL_NOT_ALLOWED\", language: null, path: null, message: \"Job not found or in a non-cancellable state.\" }],\n    nextAllowedActions: [\"status\"],\n  };\n}\nreturn {\n  success: true,\n  jobId: row.job_id,\n  status: \"CANCELLED\",\n  message: \"Job cancelled.\",\n  data: {},\n  warnings: [],\n  errors: [],\n  nextAllowedActions: [],\n};"
