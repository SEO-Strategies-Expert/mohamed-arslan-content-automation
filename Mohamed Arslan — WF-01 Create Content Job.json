    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ctx = $(\"10 Check Manifest Exists\").item.json;\nconst m = ($json && $json.manifest) ? $json.manifest : null;\nlet errorCode = null;\nlet errorMessage = null;\nconst missing = [];\nif (!m || typeof m !== \"object\") {\n  errorCode = \"MANIFEST_INVALID\";\n  errorMessage = \"manifest.json could not be parsed as an object.\";\n} else {\n  const required = [\"schemaVersion\", \"jobId\", \"siteKey\", \"operation\", \"targetLanguages\", \"driveFolderId\", \"content\"];\n  for (const key of required) {\n    if (m[key] === undefined || m[key] === null || m[key] === \"\") missing.push(key);\n  }\n  if (!Array.isArray(m.targetLanguages) || m.targetLanguages.length === 0) {\n    if (!missing.includes(\"targetLanguages\")) missing.push(\"targetLanguages\");\n  }\n  if (missing.length > 0) {\n    errorCode = \"MANIFEST_INVALID\";\n    errorMessage = \"manifest.json is missing required fields: \" + missing.join(\", \") + \".\";\n  } else if (String(m.jobId) !== String(ctx.jobId)) {\n    errorCode = \"MANIFEST_INVALID\";\n    errorMessage = \"manifest jobId (\" + m.jobId + \") does not match requested jobId (\" + ctx.jobId + \").\";\n  }\n}\nreturn {\n  jobId: ctx.jobId,\n  siteKey: ctx.siteKey,\n  environment: ctx.environment,\n  driveFolderId: ctx.driveFolderId,\n  manifestFileId: ctx.manifestFileId,\n  manifest: m,\n  ok: errorCode === null,\n  errorCode,\n  errorMessage,\n};"
