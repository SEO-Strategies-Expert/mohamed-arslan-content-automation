    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE content_jobs SET status = 'ASSETS_PROCESSING', updated_at = NOW() WHERE job_id = $1 RETURNING job_id, status;",
        "options": {
          "queryReplacement": "={{ $json.jobId }}"
        }
      },
      "id": "05820194-9128-4091-a829-102938102955",
