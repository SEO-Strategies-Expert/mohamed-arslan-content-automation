    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const tasks = $(\"05 Parse Manifest And Build Asset Tasks\").all();\nconst requiredAssetCount = tasks[0].json.emptyAssets ? 0 : tasks.length;\nconst requiredAssetKeys = tasks[0].json.emptyAssets ? [] : tasks.map(t => t.json.assetKey);\n\nconst uploaded = $(\"11 Execute WF-10 Upload Media\").all() || [];\nconst selected = $(\"09 Execute WF-08 Before-After Selector\").all() || [];\n\nconst completedAssetKeys = [];\nlet failedAssetCount = 0;\nconst errors = [];\n\nfor (const item of uploaded) {\n  const j = item.json || {};\n  if (j && (j.normalized ? j.normalized.success === true : j.success === true)) {\n    completedAssetKeys.push(j.assetKey);\n  } else {\n    failedAssetCount++;\n    errors.push({ code: \"UPLOAD_FAILED\", message: j.message || \"Asset upload failed.\" });\n  }\n}\n\nfor (const item of selected) {\n  const j = item.json || {};\n  if (j && (j.normalized ? j.normalized.success === true : j.success === true)) {\n    completedAssetKeys.push(j.assetKey);\n  } else {\n    failedAssetCount++;\n    errors.push({ code: \"SELECTION_FAILED\", message: j.message || \"Before-after selection failed.\" });\n  }\n}\n\nconst completedAssetCount = completedAssetKeys.length;\nconst passed = (requiredAssetCount === completedAssetCount) && (failedAssetCount === 0);\nconst base = $(\"03B Verify Lock Acquired\").item.json;\n\nreturn {\n  json: {\n    jobId: base.jobId,\n    lockKey: base.lockKey,\n    requiredAssetCount,\n    completedAssetCount,\n    failedAssetCount,\n    requiredAssetKeys,\n    completedAssetKeys,\n    passed,\n    errors\n  }\n};"
      },
