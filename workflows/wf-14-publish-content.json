    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let errCtx = null;\ntry {\n  errCtx = $(\"09 Evaluate Publish API Response\").item.json;\n} catch (e) {}\nif (!errCtx || errCtx.ok) {\n  try { errCtx = $(\"06B Validate Snapshot Response\").item.json; } catch (e) {}\n}\nif (!errCtx || errCtx.ok) {\n  try { errCtx = $(\"05B Verify Lock Acquired\").item.json; } catch (e) {}\n}\nif (!errCtx || errCtx.ok) {\n  try { errCtx = $(\"03 Verify Eligibility\").item.json; } catch (e) {}\n}\nconst jobId = (errCtx && errCtx.jobId) ? errCtx.jobId : null;\nconst lockKey = (errCtx && errCtx.lockKey) ? errCtx.lockKey : null;\nconst errorCode = (errCtx && errCtx.errorCode) ? errCtx.errorCode : \"PUBLISH_ERROR\";\nconst errorMessage = (errCtx && errCtx.errorMessage) ? errCtx.errorMessage : \"An error occurred while publishing content.\";\nreturn {\n  jobId,\n  lockKey,\n  errorCode,\n  errorMessage\n};"
      },
