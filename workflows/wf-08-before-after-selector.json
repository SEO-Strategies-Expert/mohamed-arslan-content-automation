{
  "name": "Mohamed Arslan — WF-08 Before-After Selector",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "jobId"
            },
            {
              "name": "assetKey"
            },
            {
              "name": "category"
            }
          ]
        }
      },
      "id": "e800284a-7182-44df-a8b2-5f60d6211234",
      "name": "01 Input Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        192
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json || {};\nconst jobId = (j.jobId || \"\").trim();\nconst assetKey = (j.assetKey || \"before-after-1\").trim();\nconst category = (j.category || \"general\").trim();\n\nif (!jobId) {\n  return { ok: false, errorCode: \"INVALID_INPUT\", errorMessage: \"jobId is required for before-after selector.\" };\n}\nif (!assetKey) {\n  return { ok: false, errorCode: \"INVALID_INPUT\", errorMessage: \"assetKey is required for before-after selector.\" };\n}\n\nreturn {\n  jobId,\n  assetKey,\n  assetType: \"before_after\",\n  category,\n  ok: true\n};"
      },
      "id": "02810294-8172-491a-b812-701928301928",
      "name": "02 Validate Selector Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        192
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "ok",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "03820194-9128-4019-a829-109284019288",
      "name": "03 Input OK Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        448,
        192
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, asset_key, media_id, final_url, width, height, file_size_bytes, mime_type, checksum, category\nFROM media_assets\nWHERE asset_type = 'before_after'\n  AND approval_status = 'approved'\n  AND (category = $1 OR $1 = 'general')\nORDER BY used_count ASC, created_at DESC\nLIMIT 1\nFOR UPDATE SKIP LOCKED;",
        "options": {
          "queryReplacement": "={{ [$json.category] }}"
        }
      },
      "id": "04820194-9128-4091-a829-102938102980",
      "name": "04 Query Approved Before-After Asset",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        672,
        128
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const p = $(\"02 Validate Selector Input\").item.json;\nconst row = ($json && $json.id) ? $json : null;\n\nif (!row) {\n  return {\n    json: {\n      ok: false,\n      jobId: p.jobId,\n      errorCode: \"NO_APPROVED_ASSET_FOUND\",\n      errorMessage: \"No approved before/after asset available in category: \" + p.category\n    }\n  };\n}\n\nreturn {\n  json: {\n    ok: true,\n    jobId: p.jobId,\n    assetKey: p.assetKey,\n    assetType: \"before_after\",\n    category: row.category || p.category,\n    finalUrl: row.final_url,\n    mediaId: row.media_id,\n    width: row.width || 1200,\n    height: row.height || 630,\n    fileSizeBytes: row.file_size_bytes || 0,\n    mimeType: row.mime_type || \"image/webp\",\n    checksum: row.checksum || \"\",\n    bypassOptimization: true,\n    bypassUpload: true\n  }\n};"
      },
      "id": "05820194-9128-4091-a829-102938102981",
      "name": "05 Format Selected Asset Metadata",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        128
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "ok",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "06820194-9128-4091-a829-102938102982",
      "name": "06 Asset Selected Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1120,
        128
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const m = $json;\nconst norm = {\n  success: true,\n  jobId: m.jobId,\n  status: \"ASSET_SELECTED\",\n  message: \"Approved before/after asset selected from repository.\",\n  data: {\n    jobId: m.jobId,\n    assetKey: m.assetKey,\n    assetType: m.assetType,\n    category: m.category,\n    finalUrl: m.finalUrl,\n    mediaId: m.mediaId,\n    width: m.width,\n    height: m.height,\n    fileSizeBytes: m.fileSizeBytes,\n    checksum: m.checksum,\n    mimeType: m.mimeType,\n    bypassOptimization: true,\n    bypassUpload: true\n  },\n  warnings: [],\n  errors: [],\n  nextAllowedActions: [\"create_preview\"]\n};\n\nreturn {\n  json: {\n    ...m,\n    normalized: norm\n  }\n};"
      },
      "id": "07829104-9128-4902-8172-910293810299",
      "name": "07 Return Normalized Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        64
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json || {};\nconst code = j.errorCode || \"NO_APPROVED_ASSET_FOUND\";\nconst message = j.errorMessage || \"Failed to select approved before/after asset.\";\nreturn {\n  json: {\n    success: false,\n    jobId: j.jobId || null,\n    status: \"FAILED\",\n    message,\n    data: null,\n    warnings: [],\n    errors: [{ code, language: null, path: null, message }],\n    nextAllowedActions: [\"cancel\"]\n  }\n};"
      },
      "id": "99820194-8172-4091-b812-701928301938",
      "name": "99 Build Error Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        280
      ]
    },
