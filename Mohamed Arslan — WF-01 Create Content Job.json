        "jsCode": "const c = $json || {};\nconst jobId = c.jobId || \"\";\n// jobId format: MOHAMED-ARSLAN-<SITE>-<TYPE>-<YYYYMMDD>-<NNNN>\nconst jobIdPattern = /^MOHAMED-ARSLAN-[A-Z0-9]+-[A-Z0-9]+-[0-9]{8}-[0-9]{4}$/;\nlet errorCode = null;\nlet errorMessage = null;\nif (!jobIdPattern.test(jobId)) {\n  errorCode = \"INVALID_JOB_ID\";\n  errorMessage = \"jobId does not match required format MOHAMED-ARSLAN-<SITE>-<TYPE>-<YYYYMMDD>-<NNNN>.\";\n}\nreturn {\n  jobId: c.jobId,\n  siteKey: c.siteKey,\n  environment: c.environment,\n  driveFolderId: c.driveFolderId,\n  ok: errorCode === null,\n  errorCode,\n  errorMessage,\n};"
