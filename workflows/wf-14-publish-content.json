        "jsCode": "const row = ($json && $json.job_id) ? $json : null;\nconst base = $(\"03 Verify Eligibility\").item.json;\nif (!row || !row.lock_key) {\n  return {\n    ok: false,\n    jobId: base.jobId,\n    lockKey: null,\n    errorCode: \"PUBLISH_LOCKED\",\n    errorMessage: \"Could not acquire publish lock or job status is no longer APPROVED.\"\n  };\n}\nreturn {\n  ok: true,\n  jobId: base.jobId,\n  lockKey: row.lock_key,\n  contentId: row.content_id,\n  job: base.job\n};"
