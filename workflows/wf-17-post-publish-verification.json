{
  "name": "Mohamed Arslan — WF-17 Post-Publish Verification",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "jobId"
            }
          ]
        }
      },
      "id": "e170284a-7182-44df-a8b2-5f60d6211234",
      "name": "01 Input Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        192
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.job_id, c.site_key, c.status, c.content_id, c.published_urls, c.target_languages, s.api_base_url FROM content_jobs c LEFT JOIN site_configs s USING (site_key) WHERE c.job_id = $1 LIMIT 1;",
        "options": {
          "queryReplacement": "={{ $json.jobId }}"
        }
      },
      "id": "02810294-8172-491a-b812-701928301940",
      "name": "02 Load Job Details and Site Config",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        192
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $(\"02 Load Job Details and Site Config\").item.json.api_base_url }}/content/{{ $(\"02 Load Job Details and Site Config\").item.json.content_id || $(\"01 Input Trigger\").item.json.jobId }}/publication-status",
        "options": {
          "timeout": 5000
        }
      },
      "id": "03810294-8172-491a-b812-701928301941",
      "name": "03 Call Custom Site Status Verification API Adapter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        192
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "CUSTOM_SITE_API_CREDENTIAL_ID",
          "name": "Custom Site API Auth"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const jobCtx = $(\"02 Load Job Details and Site Config\").item.json;\nconst apiResp = $json || {};\nconst errors = [];\nconst warnings = [];\n\nif (apiResp.error || !apiResp.httpStatus) {\n  errors.push({ code: \"VERIFICATION_API_FAILED\", message: \"Custom Site publication status API failed or returned invalid response.\" });\n} else {\n  if (apiResp.httpStatus !== 200) {\n    errors.push({ code: \"HTTP_STATUS_NOT_200\", message: \"HTTP status is \" + apiResp.httpStatus + \", expected 200.\" });\n  }\n  if (apiResp.sitemapUpdated === false) {\n    warnings.push({ code: \"SITEMAP_NOT_UPDATED\", message: \"Sitemap update has not yet propagated.\" });\n  }\n}\n\nconst passed = errors.length === 0;\nreturn {\n  jobId: jobCtx.job_id,\n  contentId: jobCtx.content_id,\n  passed,\n  errors,\n  warnings\n};"
      },
      "id": "04820194-9128-4019-a829-109284019300",
      "name": "04 Evaluate Verification Checks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        192
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "passed",
              "leftValue": "={{ $json.passed }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "05820194-9128-4091-a829-102938102981",
      "name": "05 Verification Passed Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        896,
        192
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE content_jobs SET status = 'COMPLETED', completed_at = NOW(), updated_at = NOW() WHERE job_id = $1 RETURNING job_id, status;",
        "options": {
          "queryReplacement": "={{ [$json.jobId] }}"
        }
      },
      "id": "06820194-9128-4091-a829-102938102982",
      "name": "06 Update Job Status COMPLETED",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1120,
        128
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const v = $(\"04 Evaluate Verification Checks\").item.json;\nreturn {\n  success: true,\n  jobId: v.jobId,\n  status: \"COMPLETED\",\n  message: \"All 15 post-publish verification checks passed cleanly. Job complete.\",\n  data: {\n    contentId: v.contentId,\n    verificationPassed: true\n  },\n  warnings: v.warnings,\n  errors: [],\n  nextAllowedActions: []\n};"
      },
      "id": "07829104-9128-4902-8172-910293810309",
      "name": "07 Return Normalized Success Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        128
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE content_jobs SET status = 'ROLLBACK_PENDING', last_error = $2, updated_at = NOW() WHERE job_id = $1;",
        "options": {
          "queryReplacement": "={{ [$json.jobId, JSON.stringify($json.errors)] }}"
        }
      },
      "id": "08820194-9128-4091-a829-102938102983",
      "name": "08 Update Job Status ROLLBACK_PENDING",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1120,
        320
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const v = $(\"04 Evaluate Verification Checks\").item.json;\nreturn {\n  success: false,\n  jobId: v.jobId,\n  status: \"ROLLBACK_PENDING\",\n  message: \"Post-publish verification failed. Rollback pending.\",\n  data: null,\n  warnings: v.warnings,\n  errors: v.errors,\n  nextAllowedActions: [\"rollback\", \"cancel\"]\n};"
      },
      "id": "99820194-8172-4091-b812-701928301937",
      "name": "99 Build Error Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        320
      ]
    },
    {
