        "jsCode": "const j = $json || {};\nconst code = j.errorCode || \"UNKNOWN_ERROR\";\nconst message = j.errorMessage || \"An unknown error occurred while creating the content job.\";\nlet jobId = j.jobId || null;\nif (!jobId) { try { jobId = $(\"01 Input Trigger\").item.json.jobId || null; } catch (e) { jobId = null; } }\n// Retry is allowed only for transient / correctable cases\nconst retryable = [\"DRIVE_FOLDER_NOT_FOUND\", \"MANIFEST_MISSING\", \"MANIFEST_INVALID\", \"DATABASE_ERROR\"];\nconst nextAllowedActions = retryable.includes(code) ? [\"retry\", \"cancel\"] : [\"cancel\"];\nreturn {\n  success: false,\n  jobId,\n  status: \"FAILED\",\n  message,\n  data: null,\n  warnings: [],\n  errors: [{ code, message }],\n  nextAllowedActions,\n};"
