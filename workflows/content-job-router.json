    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const jobId = $(\"02 Validate Tool Input\").item.json.jobId;\nconst row = ($json && $json.job_id) ? $json : null;\nif (!row) {\n  return {\n    success: false,\n    jobId,\n    status: \"FAILED\",\n    message: \"No job found for jobId \" + jobId + \".\",\n    data: null,\n    warnings: [],\n    errors: [{ code: \"JOB_NOT_FOUND\", language: null, path: null, message: \"No content_jobs row found.\" }],\n    nextAllowedActions: [],\n  };\n}\nconst nextByStatus = {\n  CREATED: [\"validate\", \"cancel\"],\n  VALIDATION_FAILED: [\"retry\", \"cancel\"],\n  CONTENT_READY: [\"prepare_assets\", \"cancel\"],\n};\nreturn {\n  success: true,\n  jobId: row.job_id,\n  status: row.status,\n  message: \"Current job status retrieved.\",\n  data: {\n    siteKey: row.site_key,\n    operation: row.operation,\n    targetLanguages: row.target_languages,\n    previewUrls: row.preview_urls,\n    publishedUrls: row.published_urls,\n    scheduledAt: row.scheduled_at,\n    updatedAt: row.updated_at,\n  },\n  warnings: [],\n  errors: [],\n  nextAllowedActions: nextByStatus[row.status] || [\"cancel\"],\n};"
      },
      "id": "1490f602-ae38-4e2d-b40d-be9e118ec895",
      "name": "31 Normalize Status",
      "type": "n8n-nodes-base.code",
