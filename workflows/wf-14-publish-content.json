      "id": "e140284a-7182-44df-a8b2-5f60d6211234",
      "name": "01 Input Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        192
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.job_id, c.site_key, c.status, c.content_id, c.target_languages, c.approval_required, c.approved_by, s.api_base_url FROM content_jobs c LEFT JOIN site_configs s USING (site_key) WHERE c.job_id = $1 LIMIT 1;",
        "options": {
          "queryReplacement": "={{ $json.jobId }}"
        }
      },
      "id": "02810294-8172-491a-b812-701928301935",
      "name": "02 Load Job Details and Site Config",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        192
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const jobId = $(\"01 Input Trigger\").item.json.jobId || ($json && $json.job_id);\nconst row = ($json && $json.job_id) ? $json : null;\nlet errorCode = null;\nlet errorMessage = null;\nif (!row) {\n  errorCode = \"JOB_NOT_FOUND\";\n  errorMessage = \"No content_jobs row found for jobId \" + jobId + \".\";\n} else {\n  if (row.approval_required && row.status !== \"APPROVED\") {\n    errorCode = \"APPROVAL_REQUIRED\";\n    errorMessage = \"Publishing requires human approval. Current status: \" + row.status + \".\";\n  }\n}\nreturn { jobId, job: row, ok: errorCode === null, errorCode, errorMessage };"
      },
      "id": "03820194-9128-4019-a829-109284019295",
      "name": "03 Verify Approval State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        192
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "ok",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "04829104-9128-4902-8172-910293810305",
      "name": "04 State OK Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        672,
        192
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE content_jobs SET status = 'PUBLISHING', updated_at = NOW() WHERE job_id = $1 AND status = 'APPROVED' RETURNING job_id, status;",
        "options": {
          "queryReplacement": "={{ $json.jobId }}"
        }
      },
      "id": "05820194-9128-4091-a829-102938102971",
      "name": "05 Acquire Lock and Set PUBLISHING",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        896,
        128
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $(\"03 Verify Approval State\").item.json.job.api_base_url }}/content/{{ $(\"03 Verify Approval State\").item.json.job.content_id || $(\"03 Verify Approval State\").item.json.job.job_id }}",
        "options": {
          "timeout": 5000
        }
      },
      "id": "06810294-8172-491a-b812-701928301937",
      "name": "06 Fetch Existing Page Content Snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1120,
        128
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "CUSTOM_SITE_API_CREDENTIAL_ID",
          "name": "Custom Site API Auth"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO content_revisions (job_id, content_id, revision_id, snapshot)\nVALUES ($1, $2, $3, $4::jsonb)\nRETURNING id, revision_id;",
        "options": {
          "queryReplacement": "={{ [$(\"03 Verify Approval State\").item.json.job.job_id, ($(\"03 Verify Approval State\").item.json.job.content_id || $(\"03 Verify Approval State\").item.json.job.job_id), (\"REV-\" + Date.now()), JSON.stringify($json)] }}"
        }
      },
      "id": "07820194-9128-4091-a829-102938102972",
      "name": "07 Create Revision Snapshot Record",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1344,
        128
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $(\"03 Verify Approval State\").item.json.job.api_base_url }}/content/{{ $(\"03 Verify Approval State\").item.json.job.job_id }}/publish",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "={{ $(\"03 Verify Approval State\").item.json.job.job_id }}-publish-v1"
            }
          ]
        },
        "options": {
          "timeout": 5000
        }
      },
      "id": "08810294-8172-491a-b812-701928301938",
      "name": "08 Call Custom Site Publish API Adapter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1568,
        128
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "CUSTOM_SITE_API_CREDENTIAL_ID",
          "name": "Custom Site API Auth"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const jobCtx = $(\"03 Verify Approval State\").item.json.job;\nconst resp = $json || {};\nconst isSuccess = resp && resp.publishedUrls && typeof resp.publishedUrls === \"object\" && Object.keys(resp.publishedUrls).length > 0;\n\nif (!isSuccess) {\n  return {\n    ok: false,\n    jobId: jobCtx.job_id,\n    errorCode: \"PUBLISH_API_FAILED\",\n    errorMessage: (resp && resp.message) ? resp.message : \"Custom Site API publish request failed or returned invalid response.\"\n  };\n}\n\nreturn {\n  ok: true,\n  jobId: jobCtx.job_id,\n  contentId: resp.contentId || jobCtx.content_id || jobCtx.job_id,\n  publishedUrls: resp.publishedUrls\n};"
      },
      "id": "09820194-9128-4019-a829-109284019296",
      "name": "09 Evaluate Publish API Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        128
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "ok",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
