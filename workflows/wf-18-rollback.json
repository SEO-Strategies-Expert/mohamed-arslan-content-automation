{
  "name": "Mohamed Arslan — WF-18 Rollback",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "jobId"
            }
          ]
        }
      },
      "id": "e180284a-7182-44df-a8b2-5f60d6211234",
      "name": "01 Input Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        192
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.job_id, c.site_key, c.status, c.content_id, s.api_base_url FROM content_jobs c LEFT JOIN site_configs s USING (site_key) WHERE c.job_id = $1 LIMIT 1;",
        "options": {
          "queryReplacement": "={{ $json.jobId }}"
        }
      },
      "id": "02810294-8172-491a-b812-701928301941",
      "name": "02 Load Job Details and Site Config",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        192
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT revision_id, content_id, snapshot FROM content_revisions WHERE job_id = $1 ORDER BY created_at DESC LIMIT 1;",
        "options": {
          "queryReplacement": "={{ $json.job_id }}"
        }
      },
      "id": "03820194-9128-4091-a829-102938102983",
      "name": "03 Load Latest Revision Snapshot",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        448,
        192
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const jobCtx = $(\"02 Load Job Details and Site Config\").item.json;\nconst rev = ($json && $json.revision_id) ? $json : null;\nlet errorCode = null;\nlet errorMessage = null;\nif (!rev) {\n  errorCode = \"NO_REVISION_FOUND\";\n  errorMessage = \"No content_revisions snapshot found to perform rollback for job \" + jobCtx.job_id;\n}\nreturn { jobId: jobCtx.job_id, apiBaseUrl: jobCtx.api_base_url, revision: rev, ok: errorCode === null, errorCode, errorMessage };"
      },
      "id": "04820194-9128-4019-a829-109284019301",
      "name": "04 Verify Revision Available",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        192
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "ok",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "05820194-9128-4091-a829-102938102984",
      "name": "05 Revision OK Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        896,
        192
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.apiBaseUrl }}/content/{{ $json.revision.content_id }}/rollback",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ revisionId: $json.revision.revision_id, snapshot: $json.revision.snapshot }) }}",
        "options": {
          "timeout": 5000
        }
      },
      "id": "06810294-8172-491a-b812-701928301942",
      "name": "06 Call Rollback API Adapter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1120,
        128
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "CUSTOM_SITE_API_CREDENTIAL_ID",
          "name": "Custom Site API Auth"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const revCtx = $(\"04 Verify Revision Available\").item.json;\nconst resp = $json || {};\nconst isSuccess = !resp.error && (resp.success !== false);\nif (!isSuccess) {\n  return {\n    ok: false,\n    jobId: revCtx.jobId,\n    errorCode: \"ROLLBACK_API_FAILED\",\n    errorMessage: (resp && resp.message) ? resp.message : \"Custom Site API rollback endpoint returned an error.\"\n  };\n}\nreturn { ok: true, jobId: revCtx.jobId, revisionId: revCtx.revision.revision_id };"
      },
      "id": "07820194-9128-4019-a829-109284019302",
      "name": "07 Evaluate Rollback API Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        128
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "ok",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "08820194-9128-4091-a829-102938102985",
      "name": "08 Rollback Succeeded Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1568,
        128
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE content_jobs SET status = 'ROLLED_BACK', updated_at = NOW() WHERE job_id = $1 RETURNING job_id, status;",
        "options": {
          "queryReplacement": "={{ [$json.jobId] }}"
        }
      },
      "id": "09820194-9128-4091-a829-102938102986",
      "name": "09 Update Job Status ROLLED_BACK",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1792,
        64
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const rb = $(\"07 Evaluate Rollback API Result\").item.json;\nreturn {\n  success: true,\n  jobId: rb.jobId,\n  status: \"ROLLED_BACK\",\n  message: \"Content successfully reverted to revision snapshot \" + rb.revisionId,\n  data: {\n    revisionId: rb.revisionId\n  },\n  warnings: [],\n  errors: [],\n  nextAllowedActions: [\"retry\", \"cancel\"]\n};"
      },
      "id": "10829104-9128-4902-8172-910293810310",
      "name": "10 Return Normalized Success Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2016,
        64
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE content_jobs SET status = 'FAILED', last_error = $2, updated_at = NOW() WHERE job_id = $1;",
        "options": {
          "queryReplacement": "={{ [$json.jobId, $json.errorMessage] }}"
        }
      },
      "id": "11820194-9128-4091-a829-102938102987",
      "name": "11 Set Status FAILED On Rollback Error",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1792,
        288
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $(\"07 Evaluate Rollback API Result\").item.json || $json || {};\nconst code = j.errorCode || \"ROLLBACK_FAILED\";\nconst message = j.errorMessage || \"An error occurred during content rollback.\";\nreturn {\n  success: false,\n  jobId: j.jobId || null,\n  status: \"FAILED\",\n  message,\n  data: null,\n  warnings: [],\n  errors: [{ code, language: null, path: null, message }],\n  nextAllowedActions: [\"cancel\"]\n};"
      },
      "id": "99820194-8172-4091-b812-701928301938",
      "name": "99 Build Error Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2016,
        288
      ]
    },
    {
