    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const input = $(\"01 Input Trigger\").item.json;\nconst row = ($json && $json.job_id) ? $json : null;\nlet errorCode = null;\nlet errorMessage = null;\nif (!row) {\n  errorCode = \"JOB_NOT_FOUND\";\n  errorMessage = \"No content_jobs row found for jobId \" + input.jobId;\n} else {\n  const allowed = [\"CONTENT_READY\", \"ASSETS_PROCESSING\"];\n  if (!allowed.includes(String(row.status))) {\n    errorCode = \"INVALID_STATE\";\n    errorMessage = \"Prepare assets is only allowed from CONTENT_READY or ASSETS_PROCESSING. Current status: \" + row.status;\n  }\n}\nreturn { jobId: input.jobId, job: row, lockKey: \"ASSET-LOCK-\" + Date.now(), ok: errorCode === null, errorCode, errorMessage };"
      },
