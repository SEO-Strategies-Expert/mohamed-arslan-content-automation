        "jsCode": "const j = $json || {};\nconst code = j.errorCode || \"MISSING_BINARY_IMAGE\";\nconst message = j.errorMessage || \"No binary image input supplied for optimization.\";\nreturn {\n  success: false,\n  jobId: j.jobId || null,\n  status: \"FAILED\",\n  message,\n  data: null,\n  warnings: [],\n  errors: [{ code, language: null, path: null, message }],\n  nextAllowedActions: [\"retry\", \"cancel\"]\n};"
