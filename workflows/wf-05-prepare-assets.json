    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const input = $(\"01 Input Trigger\").item.json;\nconst feat = $(\"04 Execute WF-06 Featured Image Generator\").first().json;\nconst info = $(\"05 Execute WF-07 Infographic Renderer\").first().json;\nconst opt = $(\"06 Execute WF-09 Optimize Images\").first().json;\nconst up = $(\"07 Execute WF-10 Upload Media\").first().json;\n\nconst errors = [];\nif (!feat || feat.success === false) {\n  errors.push({ code: \"FEATURED_IMAGE_FAILED\", message: (feat && feat.message) || \"WF-06 Featured Image Generator failed.\" });\n}\nif (!info || info.success === false) {\n  errors.push({ code: \"INFOGRAPHIC_FAILED\", message: (info && info.message) || \"WF-07 Infographic Renderer failed.\" });\n}\nif (!opt || opt.success === false) {\n  errors.push({ code: \"IMAGE_OPTIMIZATION_FAILED\", message: (opt && opt.message) || \"WF-09 Optimize Images failed.\" });\n}\nif (!up || up.success === false) {\n  errors.push({ code: \"MEDIA_UPLOAD_FAILED\", message: (up && up.message) || \"WF-10 Upload Media failed.\" });\n}\n\nconst passed = errors.length === 0;\nreturn {\n  jobId: input.jobId,\n  passed,\n  errors,\n  assets: passed ? [feat.data, info.data, opt.data, up.data] : []\n};"
      },
