    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT job_id, site_key, status, drive_folder_id, manifest_file_id FROM content_jobs WHERE job_id = $1 LIMIT 1;",
        "options": {
          "queryReplacement": "={{ $json.jobId }}"
        }
      },
      "id": "02810294-8172-491a-b812-701928301925",
      "name": "02 Load Job Record",
      "type": "n8n-nodes-base.postgres",
