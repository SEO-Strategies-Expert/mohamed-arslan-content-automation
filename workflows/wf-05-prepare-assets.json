    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const base = $(\"03B Verify Lock Acquired\").item.json;\nconst uploads = $input.all();\nconst errors = [];\nconst uploadedAssets = [];\n\nfor (const item of uploads) {\n  const j = item.json || {};\n  if (!j || j.success !== true) {\n    errors.push({\n      code: (j.errors && j.errors[0] && j.errors[0].code) || \"ASSET_PIPELINE_FAILED\",\n      message: (j.errors && j.errors[0] && j.errors[0].message) || j.message || \"Asset pipeline step failed for an item.\"\n    });\n  } else {\n    uploadedAssets.push(j.data);\n  }\n}\n\nconst passed = errors.length === 0 && uploads.length > 0;\nreturn {\n  json: {\n    jobId: base.jobId,\n    passed,\n    errors,\n    uploadedAssetsCount: uploadedAssets.length\n  }\n};"
      },
