      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT job_id, site_key, operation, status, target_languages, preview_urls, published_urls, scheduled_at, updated_at FROM content_jobs WHERE job_id = $1 LIMIT 1;",
        "options": {
          "queryReplacement": "={{ $json.jobId }}"
        }
      },
