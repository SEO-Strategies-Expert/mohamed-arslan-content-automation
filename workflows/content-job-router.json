    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json || {};\nconst action = (j.action || \"\").trim();\nconst jobId = (j.jobId || \"\").trim();\nconst allowed = [\"create\", \"validate\", \"status\", \"cancel\", \"retry\"];\nlet errorCode = null;\nlet errorMessage = null;\nif (!action || !allowed.includes(action)) {\n  errorCode = \"INVALID_ACTION\";\n  errorMessage = \"action must be one of: \" + allowed.join(\", \") + \".\";\n} else if (!jobId) {\n  errorCode = \"INVALID_INPUT\";\n  errorMessage = \"jobId is required for every content_job action.\";\n}\nreturn {\n  action,\n  jobId,\n  siteKey: j.siteKey || null,\n  environment: j.environment || null,\n  driveFolderId: j.driveFolderId || null,\n  publishAt: j.publishAt || null,\n  reason: j.reason || null,\n  ok: errorCode === null,\n  errorCode,\n  errorMessage,\n};"
      },
