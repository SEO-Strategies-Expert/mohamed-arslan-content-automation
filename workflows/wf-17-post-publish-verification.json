        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const v = $(\"04 Run Comprehensive Verification Suite\").item.json;\nreturn {\n  success: false,\n  jobId: v.jobId,\n  status: \"ROLLBACK_PENDING\",\n  message: \"Post-publish verification failed. Rollback initiated.\",\n  data: v.verificationDetails,\n  warnings: [],\n  errors: [{ code: \"VERIFICATION_FAILED\", language: null, path: null, message: \"Failed checks: \" + v.failedChecks.join(\", \") }],\n  nextAllowedActions: [\"rollback\", \"cancel\"]\n};"
      },
