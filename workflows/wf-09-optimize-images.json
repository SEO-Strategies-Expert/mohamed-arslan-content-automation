    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const opt = $json;\nreturn {\n  success: true,\n  jobId: opt.jobId,\n  status: \"ASSETS_READY\",\n  message: \"Image binary metadata and SHA-256 checksum calculated successfully.\",\n  data: {\n    assetKey: opt.assetKey,\n    fileSizeBytes: opt.fileSizeBytes,\n    checksum: opt.checksum,\n    mimeType: opt.mimeType\n  },\n  warnings: [],\n  errors: [],\n  nextAllowedActions: [\"upload_media\"]\n};"
      },
      "id": "04829104-9128-4902-8172-910293810314",
