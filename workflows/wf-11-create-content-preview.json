      "id": "e110284a-7182-44df-a8b2-5f60d6211234",
      "name": "01 Input Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        192
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT job_id, site_key, status, target_languages FROM content_jobs WHERE job_id = $1 LIMIT 1;",
        "options": {
          "queryReplacement": "={{ $json.jobId }}"
        }
      },
      "id": "02810294-8172-491a-b812-701928301931",
      "name": "02 Load Job Record",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        192
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const jobId = $(\"01 Input Trigger\").item.json.jobId || ($json && $json.job_id);\nconst row = ($json && $json.job_id) ? $json : null;\nlet errorCode = null;\nlet errorMessage = null;\nif (!row) {\n  errorCode = \"JOB_NOT_FOUND\";\n  errorMessage = \"No content_jobs row found for jobId \" + jobId + \".\";\n} else {\n  const allowed = [\"ASSETS_READY\", \"PREVIEW_CREATING\"];\n  if (!allowed.includes(String(row.status))) {\n    errorCode = \"INVALID_STATE\";\n    errorMessage = \"Preview creation is only allowed from ASSETS_READY or PREVIEW_CREATING. Current status: \" + row.status + \".\";\n  }\n}\nreturn { jobId, job: row, ok: errorCode === null, errorCode, errorMessage };"
      },
      "id": "03820194-9128-4019-a829-109284019291",
      "name": "03 Check Job State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        192
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "ok",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "04829104-9128-4902-8172-910293810301",
      "name": "04 State OK Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        672,
        192
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE content_jobs SET status = 'PREVIEW_CREATING', updated_at = NOW() WHERE job_id = $1 RETURNING job_id, status;",
        "options": {
          "queryReplacement": "={{ $json.jobId }}"
        }
      },
      "id": "05820194-9128-4091-a829-102938102963",
      "name": "05 Set Status PREVIEW_CREATING",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        896,
        128
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://development.example.com/api/automation/v1/content/preview",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jobId: $json.job_id }) }}",
        "options": {
          "timeout": 5000
        }
      },
      "id": "06810294-8172-491a-b812-701928301932",
      "name": "06 Call Preview API Adapter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1120,
        128
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const jobCtx = $(\"03 Check Job State\").item.json.job;\nconst resp = $json || {};\nconst previewUrls = resp.previewUrls || {\n  ar: \"https://development.example.com/preview/ar/hair-transplant-cost-turkey\",\n  en: \"https://development.example.com/preview/en/hair-transplant-cost-turkey\"\n};\nreturn {\n  jobId: jobCtx.job_id,\n  previewUrls\n};"
      },
      "id": "07820194-9128-4019-a829-109284019292",
      "name": "07 Extract Preview URLs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        128
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE content_jobs SET status = 'REVIEW_PENDING', preview_urls = $2::jsonb, updated_at = NOW() WHERE job_id = $1 RETURNING job_id, status;",
        "options": {
          "queryReplacement": "={{ [$json.jobId, JSON.stringify($json.previewUrls)] }}"
        }
      },
      "id": "08820194-9128-4091-a829-102938102964",
      "name": "08 Update Status REVIEW_PENDING",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1568,
        128
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO job_events (job_id, event_type, workflow_name, execution_id, payload)\nVALUES ($1, 'REVIEW_PENDING', 'Mohamed Arslan — WF-11 Create Content Preview', $2, $3::jsonb);",
        "options": {
          "queryReplacement": "={{ [$json.job_id, $execution.id, JSON.stringify({ previewUrls: $(\"07 Extract Preview URLs\").item.json.previewUrls })] }}"
        }
      },
      "id": "09820194-9128-4091-a829-102938102965",
      "name": "09 Log Review Pending Event",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1792,
        128
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const p = $(\"07 Extract Preview URLs\").item.json;\nreturn {\n  success: true,\n  jobId: p.jobId,\n  status: \"REVIEW_PENDING\",\n  message: \"Content preview created successfully and pending human review.\",\n  data: {\n    previewUrls: p.previewUrls\n  },\n  warnings: [],\n  errors: [],\n  nextAllowedActions: [\"approve\", \"reject\", \"cancel\"]\n};"
      },
      "id": "10829104-9128-4902-8172-910293810302",
      "name": "10 Return Normalized Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2016,
        128
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json || {};\nconst code = j.errorCode || \"UNKNOWN_ERROR\";\nconst message = j.errorMessage || \"An error occurred while creating content preview.\";\nconst jobId = j.jobId || null;\nreturn {\n  success: false,\n  jobId,\n  status: \"FAILED\",\n  message,\n  data: null,\n  warnings: [],\n  errors: [{ code, language: null, path: null, message }],\n  nextAllowedActions: [\"retry\", \"cancel\"]\n};"
      },
