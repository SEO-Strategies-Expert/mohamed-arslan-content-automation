        "jsCode": "const evalResult = $(\"12 Evaluate All Asset Upload Results\").item.json || $(\"02B Check State Eligibility\").item.json || $json || {};\nconst code = (evalResult.errors && evalResult.errors[0] && evalResult.errors[0].code) || evalResult.errorCode || \"ASSET_PIPELINE_FAILED\";\nconst message = (evalResult.errors && evalResult.errors[0] && evalResult.errors[0].message) || evalResult.errorMessage || \"Asset pipeline failed during execution.\";\nconst status = \"FAILED\";\nreturn {\n  success: false,\n  jobId: evalResult.jobId || null,\n  status,\n  message,\n  data: null,\n  warnings: [],\n  errors: evalResult.errors || [{ code, language: null, path: null, message }],\n  nextAllowedActions: [\"retry\", \"cancel\"]\n};"
