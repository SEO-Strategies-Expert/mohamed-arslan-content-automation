    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const input = $(\"02 Validate Input\").item.json;\nconst row = $(\"20 Execute Retry Job\").item.json;\nif (!row || !row.job_id) {\n  return {\n    success: false,\n    jobId: input.jobId,\n    status: \"FAILED\",\n    message: \"Job could not be retried — status not eligible for retry.\",\n    data: null,\n    warnings: [],\n    errors: [{ code: \"RETRY_FAILED\", language: null, path: null, message: \"Job is not in FAILED, VALIDATION_FAILED, or ASSETS_PROCESSING status.\" }],\n    nextAllowedActions: [\"status\"]\n  };\n}\nreturn {\n  success: true,\n  jobId: row.job_id,\n  status: row.status,\n  message: \"Content job retry initiated successfully.\",\n  data: { newStatus: row.status, retryCount: row.retry_count },\n  warnings: [],\n  errors: [],\n  nextAllowedActions: row.status === \"CREATED\" ? [\"validate\", \"cancel\"] : [\"prepare_assets\", \"cancel\"]\n};"
      },
      "id": "22820194-9128-4091-a829-102938102954",
