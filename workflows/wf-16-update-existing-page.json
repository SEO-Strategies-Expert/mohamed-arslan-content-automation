{
  "name": "Mohamed Arslan — WF-16 Update Existing Page",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "jobId"
            },
            {
              "name": "contentId"
            }
          ]
        }
      },
      "id": "e160284a-7182-44df-a8b2-5f60d6211234",
      "name": "01 Input Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        192
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.job_id, c.site_key, c.status, c.content_id, s.api_base_url FROM content_jobs c LEFT JOIN site_configs s USING (site_key) WHERE c.job_id = $1 LIMIT 1;",
        "options": {
          "queryReplacement": "={{ $json.jobId }}"
        }
      },
      "id": "02810294-8172-491a-b812-701928301939",
      "name": "02 Load Job Details and Site Config",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        192
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $(\"02 Load Job Details and Site Config\").item.json.api_base_url }}/content/{{ $json.content_id || $(\"01 Input Trigger\").item.json.contentId || $(\"01 Input Trigger\").item.json.jobId }}",
        "options": {
          "timeout": 5000
        }
      },
      "id": "03810294-8172-491a-b812-701928301940",
      "name": "03 Fetch Current Page Content Snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        192
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "CUSTOM_SITE_API_CREDENTIAL_ID",
          "name": "Custom Site API Auth"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO content_revisions (job_id, content_id, revision_id, snapshot)\nVALUES ($1, $2, $3, $4::jsonb)\nRETURNING id, revision_id;",
        "options": {
          "queryReplacement": "={{ [$(\"01 Input Trigger\").item.json.jobId, ($(\"02 Load Job Details and Site Config\").item.json.content_id || $(\"01 Input Trigger\").item.json.contentId || $(\"01 Input Trigger\").item.json.jobId), (\"PRE-PATCH-\" + Date.now()), JSON.stringify($json)] }}"
        }
      },
      "id": "04820194-9128-4091-a829-102938102978",
      "name": "04 Create Pre-Update Revision Record",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        672,
        192
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $(\"02 Load Job Details and Site Config\").item.json.api_base_url }}/content/{{ $(\"02 Load Job Details and Site Config\").item.json.content_id || $(\"01 Input Trigger\").item.json.contentId || $(\"01 Input Trigger\").item.json.jobId }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jobId: $(\"01 Input Trigger\").item.json.jobId, updateMode: \"patch\" }) }}",
        "options": {
          "timeout": 5000
        }
      },
      "id": "05810294-8172-491a-b812-701928301941",
      "name": "05 Call Custom Site Patch API Adapter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        896,
        192
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "CUSTOM_SITE_API_CREDENTIAL_ID",
          "name": "Custom Site API Auth"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const input = $(\"01 Input Trigger\").item.json;\nconst resp = $json || {};\nconst isSuccess = !resp.error && (resp.success !== false);\nif (!isSuccess) {\n  return {\n    ok: false,\n    jobId: input.jobId,\n    errorCode: \"UPDATE_API_FAILED\",\n    errorMessage: (resp && resp.message) ? resp.message : \"Custom Site API patch update endpoint returned an error.\"\n  };\n}\nreturn { ok: true, jobId: input.jobId, contentId: input.contentId || input.jobId };"
      },
      "id": "06820194-9128-4019-a829-109284019299",
      "name": "06 Evaluate Patch API Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        192
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "ok",
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "07820194-9128-4091-a829-102938102979",
      "name": "07 Patch Succeeded Check",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1344,
        192
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE content_jobs SET status = 'VERIFYING', updated_at = NOW() WHERE job_id = $1 RETURNING job_id, status;",
        "options": {
          "queryReplacement": "={{ [$json.jobId] }}"
        }
      },
      "id": "08820194-9128-4091-a829-102938102980",
      "name": "08 Update Job Status VERIFYING",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1568,
        128
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const u = $(\"06 Evaluate Patch API Response\").item.json;\nreturn {\n  success: true,\n  jobId: u.jobId,\n  status: \"VERIFYING\",\n  message: \"Existing page content updated via Custom Site API PATCH. Verification in progress.\",\n  data: {\n    contentId: u.contentId\n  },\n  warnings: [],\n  errors: [],\n  nextAllowedActions: [\"verify\", \"rollback\"]\n};"
      },
      "id": "09829104-9128-4902-8172-910293810308",
      "name": "09 Return Normalized Success Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        128
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE content_jobs SET status = 'FAILED', last_error = $2, updated_at = NOW() WHERE job_id = $1;",
        "options": {
          "queryReplacement": "={{ [$json.jobId, $json.errorMessage] }}"
        }
      },
      "id": "10820194-9128-4091-a829-102938102981",
      "name": "10 Set Status FAILED On Update Error",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        1568,
        320
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "POSTGRES_CREDENTIAL_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $(\"06 Evaluate Patch API Response\").item.json || $json || {};\nconst code = j.errorCode || \"UPDATE_FAILED\";\nconst message = j.errorMessage || \"An error occurred while updating existing page content.\";\nreturn {\n  success: false,\n  jobId: j.jobId || null,\n  status: \"FAILED\",\n  message,\n  data: null,\n  warnings: [],\n  errors: [{ code, language: null, path: null, message }],\n  nextAllowedActions: [\"retry\", \"cancel\"]\n};"
      },
      "id": "99820194-8172-4091-b812-701928301936",
      "name": "99 Build Error Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        320
      ]
    },
    {
