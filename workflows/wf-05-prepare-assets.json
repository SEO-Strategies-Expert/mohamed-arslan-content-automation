        "operation": "executeQuery",
        "query": "UPDATE content_jobs SET lock_key = $2, lock_expires_at = NOW() + INTERVAL '5 minutes', status = 'ASSETS_PROCESSING', updated_at = NOW() WHERE job_id = $1 AND status IN ('CONTENT_READY','ASSETS_PROCESSING') AND (lock_expires_at IS NULL OR lock_expires_at < NOW() OR lock_key = $2) RETURNING job_id, lock_key, status;",
