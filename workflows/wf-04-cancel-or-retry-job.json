    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE content_jobs\nSET status = 'CANCELLED', last_error = $2, updated_at = NOW()\nWHERE job_id = $1 AND status NOT IN ('PUBLISHED','COMPLETED','CANCELLED')\nRETURNING job_id, status;",
        "options": {
          "queryReplacement": "={{ [$json.jobId, $json.reason] }}"
        }
      },
      "id": "10820194-9128-4091-a829-102938102949",
      "name": "10 Execute Cancel Job",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
