        "jsCode": "const item = $input.item;\nlet manifest = null;\ntry {\n  if (item.binary && item.binary.data && item.binary.data.data) {\n    const raw = Buffer.from(item.binary.data.data, \"base64\").toString(\"utf-8\");\n    manifest = JSON.parse(raw);\n  } else if ($json && $json.manifest) {\n    manifest = $json.manifest;\n  }\n} catch (e) {\n  manifest = null;\n}\nreturn { manifest };"
