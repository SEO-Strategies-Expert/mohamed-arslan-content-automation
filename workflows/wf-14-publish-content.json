    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const row = ($json && $json.job_id) ? $json : null;\nconst p = $(\"09 Evaluate Publish API Response\").item.json;\nif (!row) {\n  return {\n    success: false,\n    jobId: p.jobId,\n    status: \"RECONCILIATION_REQUIRED\",\n    message: \"API published content successfully but database status update/lock release failed to return a row.\",\n    data: { contentId: p.contentId, publishedUrls: p.publishedUrls },\n    warnings: [{ code: \"DB_LOCK_RELEASE_FAILED\", message: \"Database status update failed after API published content.\" }],\n    errors: [{ code: \"RECONCILIATION_REQUIRED\", language: null, path: null, message: \"Database status update failed after API published content.\" }],\n    nextAllowedActions: [\"verify\", \"manual_reconcile\"]\n  };\n}\nreturn {\n  success: true,\n  jobId: p.jobId,\n  status: \"VERIFYING\",\n  message: \"Content published successfully to Custom Website API. Verification in progress.\",\n  data: {\n    contentId: p.contentId,\n    publishedUrls: p.publishedUrls\n  },\n  warnings: [],\n  errors: [],\n  nextAllowedActions: [\"verify\", \"rollback\"]\n};"
      },
